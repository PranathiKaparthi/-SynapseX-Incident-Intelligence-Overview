# SynapseX Environment Configuration Template
# Copy to .env for local runtime overrides

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SYNAPSEX_WORKSPACE_DEFAULT=default-ops

# Security & JWT
SYNAPSEX_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
SYNAPSEX_JWT_EXPIRATION_MS=900000
SYNAPSEX_JWT_REFRESH_EXPIRATION_MS=604800000

# Database (PostgreSQL + pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/synapsex
SPRING_DATASOURCE_USERNAME=synapsex
SPRING_DATASOURCE_PASSWORD=synapsex_secret
POSTGRES_DB=synapsex
POSTGRES_USER=synapsex
POSTGRES_PASSWORD=synapsex_secret

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=synapsex-consumer-group

# AI Provider Configuration
# Set to 'demo', 'openai', 'anthropic', or 'ollama'
SYNAPSEX_AI_PROVIDER=demo
SYNAPSEX_AI_API_KEY=
SYNAPSEX_AI_MODEL=gpt-4o
SYNAPSEX_AI_BASE_URL=https://api.openai.com/v1

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws/synapsex
